cd $(dirname $BASH_SOURCE)

if [ "$1" = --reset ]; then
  rm -rf .venv .tox build dist htmlcov qjs_wasi_reactor.wasm.egg-info
  find -name __pycache__ | xargs -r rm -rf
fi

if [ ! -d .venv ]; then
  python3 -m venv .venv --prompt="$(basename $(readlink -f .))"
fi

if [ ! -f .venv/bin/build ]; then
  echo 'exec python -m build "$@"' > .venv/bin/build
  chmod +x .venv/bin/build
fi

source .venv/bin/activate


if [ ! -f qjs-wasi-reactor/qjs-wasi-reactor.wasm ]; then
  mkdir -p qjs-wasi-reactor
  (cd qjs-wasi-reactor && wget https://github.com/quickjs-ng/quickjs/releases/download/v0.15.1/qjs-wasi-reactor.wasm)
fi

pip install -U pip setuptools
pip install -U -e . build twine
